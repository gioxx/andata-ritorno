{
  "name": "andata-ritorno-worker",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute andata-ritorno --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute andata-ritorno --local --file=schema.sql",
    "deploy:app": "npm --prefix ../app run build && wrangler deploy --config wrangler.app.toml"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
