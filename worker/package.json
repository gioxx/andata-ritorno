{
  "name": "andata-ritorno-worker",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "test": "vitest run",
    "dev": "wrangler dev --config wrangler.app.toml",
    "db:init": "wrangler d1 execute andata-ritorno --remote --file=schema.sql --config wrangler.app.toml",
    "db:init:local": "wrangler d1 execute andata-ritorno --local --file=schema.sql --config wrangler.app.toml",
    "deploy:app": "npm --prefix ../app run build && wrangler deploy --config wrangler.app.toml"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "vitest": "^4.1.12",
    "wrangler": "^4"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
