# Build for the test copy (ar-test.gioxx.org): `npm run build:test`. The buy links go through the
# Worker (/api/buy/*), which redirects to the Stripe test-mode links in [env.test.vars] (no real payments).
VITE_PAYMENTS=1
VITE_STRIPE_LINK_FAMILY=https://ar-test.gioxx.org/api/buy/family
VITE_STRIPE_LINK_SLOT=https://ar-test.gioxx.org/api/buy/slot
