# Static landing: own scripts, styles and fonts; Stripe only for the checkout dialog (loaded on a buy click).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://js.stripe.com https://*.js.stripe.com https://checkout.stripe.com; frame-src https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com https://checkout.stripe.com; connect-src https://app.ar.gxware.org https://api.stripe.com https://checkout.stripe.com; style-src 'self'; font-src 'self'; img-src 'self' https://*.stripe.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
